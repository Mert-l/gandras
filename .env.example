APP_ENV=development

STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-c1-l2a

OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen3.5:4b

MAX_AGENT_STEPS=8
MAX_IMAGERY_RETRIES=2

MAX_AOI_KM2=100
ANALYSIS_RESOLUTION_M=10

MAX_SCENE_CLOUD_PERCENT=35
MAX_LOCAL_INVALID_PERCENT=15

ENABLE_CACHE=true
CACHE_DIR=./data/cache

DATABASE_PATH=./data/investigations.db

HTTP_TIMEOUT_S=20
