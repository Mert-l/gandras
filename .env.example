APP_ENV=development

STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-c1-l2a

OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen3.5:4b

MAX_AGENT_STEPS=8
MAX_IMAGERY_RETRIES=2

MAX_AOI_KM2=100
ANALYSIS_RESOLUTION_M=10

MAX_SCENE_CLOUD_PERCENT=35
MAX_LOCAL_INVALID_PERCENT=15

ENABLE_CACHE=true
CACHE_DIR=./data/cache

DATABASE_PATH=./data/investigations.db

HTTP_TIMEOUT_S=20

# Automatic geographic research (choose tavily, brave, or searxng)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
# Explicitly configure a hosted/self-hosted Nominatim-compatible base URL.
# If using the public OSM service, read docs/location-discovery.md first.
NOMINATIM_URL=
# Used automatically when NOMINATIM_URL is empty; no additional API key needed.
PHOTON_URL=https://photon.komoot.io
LOCATION_USER_AGENT=Gandras/0.2 (https://github.com/Mert-l/gandras)
LOCATION_SEARCH_ATTEMPTS=3
PROVISIONAL_AOI_WIDTH_KM=5
